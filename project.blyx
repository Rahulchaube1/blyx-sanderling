use std::cli;
use console;
use sanderling;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Choose a cache serving mode from stored age, local elapsed time and grace policy.");
        println!("Usage: sanderling age_at_store stored now lifetime grace mandatory");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = sanderling_lookup(8.0, 100.0, 105.0, 10.0, 6.0, 0.0);
    } else {
        if count != 6 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let age_at_store = console_value(args_at(argv, 0));
        let stored = console_value(args_at(argv, 1));
        let now = console_value(args_at(argv, 2));
        let lifetime = console_value(args_at(argv, 3));
        let grace = console_value(args_at(argv, 4));
        let mandatory = console_value(args_at(argv, 5));
        result = sanderling_lookup(age_at_store, stored, now, lifetime, grace, mandatory);
    }
    if len(result) == 0 { stderr_line("Invalid input for Sanderling. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
